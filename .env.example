# Required in production — URL of the Express backend (Railway, etc.)
# Example: https://brotherhood-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001

# Customer orders → Telegram (server-only, never NEXT_PUBLIC_*)
# Create a bot via @BotFather, then message your bot and open:
# https://api.telegram.org/bot<TOKEN>/getUpdates to find "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
